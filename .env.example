# ============================================
# 钱程似锦（Qiancheng）环境变量配置模板
#
# 使用方法：复制本文件为 .env，填写真实值
# 注意：.env 文件已在 .gitignore 中，不会被提交到 GitHub
# ============================================

# ---- AI 配置（Phase 6 接入 GPT 分析时使用）----
# 支持 OpenAI 官方 API 或任意 OpenAI 兼容中转 API
# ⚠️ 真实 API Key 只能写在 .env（不提交 Git），此模板文件中禁止出现真实密钥
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# ---- 应用配置 ----
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- 自动化任务配置（Phase 8，可选，以下为默认值）----
# 是否启用后台定时任务（true/false）
AUTO_TASK_ENABLED=true
# 自动检查间隔（分钟），默认 60；开发环境建议不要太短，避免频繁调用数据源与 AI
AUTO_MONITOR_INTERVAL_MINUTES=60
# 是否自动生成 AI 每日报告（true/false；每天最多生成一次）
AUTO_DAILY_REPORT_ENABLED=true

# ---- Web 配置加密密钥（Phase 9，可选）----
# 用于加密 Web 页面保存的 AI API Key；未配置时禁止在页面保存 API Key
# 生成方式示例：python -c "import secrets; print(secrets.token_hex(32))"
FUND_PILOT_SECRET_KEY=please_generate_a_random_secret_here

# ---- 数据库配置（Phase 3 起使用，可选）----
# 留空时默认使用项目根目录下的 SQLite：data/fundpilot.db
# 后续迁移 MySQL 时填写，例如：
# DATABASE_URL=mysql+pymysql://用户名:密码@localhost:3306/qiancheng
DATABASE_URL=
